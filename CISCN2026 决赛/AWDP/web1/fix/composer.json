{
    "name": "ctf/tp8-lang-probe",
    "description": "ThinkPHP 8 localization desk challenge",
    "type": "project",
    "keywords": ["thinkphp", "ctf"],
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.1.0",
        "topthink/framework": "8.1.3",
        "topthink/think-orm": "^3.0|^4.0",
        "topthink/think-filesystem": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        },
        "psr-0": {
            "": "extend/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    }
}
